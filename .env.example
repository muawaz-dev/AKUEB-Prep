# Supabase dashboard -> Project Settings -> Database -> Connection string.
# DATABASE_URL is the app's runtime connection: use the Transaction pooler
# (port 6543) - built for many short-lived connections, which is what a
# serverless deployment (Vercel) opens under real traffic. The Session
# pooler (port 5432) reserves one real Postgres connection per client and
# caps out fast (15 total on the free tier) - using it here is what causes
# "max clients reached in session mode" errors in production.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres"

# DIRECT_URL is only for `prisma migrate`/`db push`, which need session-level
# features (advisory locks, DDL) that transaction mode doesn't support - use
# the Session pooler (port 5432) or a true direct connection here.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres"

# Admin area (/admin) credentials. Generate your own random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD="[CHOOSE-AN-ADMIN-PASSWORD]"
ADMIN_SESSION_SECRET="[RANDOM-HEX-STRING]"

# Student auth (Supabase Auth) - from Supabase dashboard: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="[YOUR-SUPABASE-PROJECT-URL]"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-SUPABASE-PUBLISHABLE-KEY]"

# Used by sitemap.xml/robots.txt/metadata to build absolute URLs. Defaults to
# https://akuebprep.com (see lib/site.ts) if unset.
NEXT_PUBLIC_SITE_URL="https://akuebprep.com"
