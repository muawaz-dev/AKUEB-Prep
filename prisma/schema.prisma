// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlockType {
  TEXT
  VIDEO
  IMAGE
  FORMULA
  WORKED_EXAMPLE
  CALLOUT
  // An inline comprehension-check question (mcq/numeric/short_text - see
  // QuestionType), rendered in place within the lesson flow. Distinct from
  // the Question model, which is the future test bank for SLO/unit/course
  // tests, not shown inline in lessons.
  QUESTION
}

enum QuestionType {
  MCQ
  NUMERIC
  SHORT_TEXT
  TRUE_FALSE
  FILL_IN_BLANK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TestScope {
  SLO
  UNIT
  COURSE
}

// A grade level, e.g. Class 9-12. Shared by Course (lesson content) and
// Question (the question bank) so both use the same identity - renaming a
// class updates everywhere at once instead of drifting apart.
model Class {
  id        String    @id @default(cuid())
  level     Int       @unique
  courses   Course[]
  chapters  Chapter[]
  questions Question[]
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A subject, e.g. Mathematics, Physics. See Class - shared the same way.
model Subject {
  id        String    @id @default(cuid())
  name      String    @unique
  courses   Course[]
  chapters  Chapter[]
  questions Question[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Course {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  class      Class         @relation(fields: [classId], references: [id])
  classId    String
  subject    Subject       @relation(fields: [subjectId], references: [id])
  subjectId  String
  board      String        @default("AKU-EB")
  status     ContentStatus @default(DRAFT)
  orderIndex Int           @default(0)
  chapters   Chapter[]
  testAttempts TestAttempt[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// Chapter's real anchor is class+subject, not Course - courseId is optional
// so a chapter (and its topics/SLOs) can exist purely to organize the
// question bank before any lesson content/Course exists for that class and
// subject, and can be attached to a Course later without disturbing anything
// nested under it (Topic/Slo/ContentBlock only ever reference their
// immediate parent, never Course, so nothing downstream needs to change when
// courseId is set or cleared).
model Chapter {
  id         String        @id @default(cuid())
  course     Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId   String?
  class      Class         @relation(fields: [classId], references: [id])
  classId    String
  subject    Subject       @relation(fields: [subjectId], references: [id])
  subjectId  String
  orderIndex Int
  title      String
  status     ContentStatus @default(DRAFT)
  topics     Topic[]
  contentBlocks ContentBlock[]
  testAttempts TestAttempt[]
  questions  Question[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([courseId, orderIndex])
}

model Topic {
  id         String        @id @default(cuid())
  chapter    Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId  String
  code       String
  orderIndex Int
  title      String
  status     ContentStatus @default(DRAFT)
  slos       Slo[]
  contentBlocks ContentBlock[]
  questions  Question[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([chapterId, code])
}

model Slo {
  id             String        @id @default(cuid())
  topic          Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId        String
  code           String
  orderIndex     Int
  sloText        String
  // Bloom's-style code from the board's own SLO documents: R=Remember,
  // U=Understand, A=Apply, An=Analyze, E=Evaluate, FA=Formative Application.
  cognitiveLevel String
  status         ContentStatus @default(DRAFT)
  contentBlocks  ContentBlock[]
  userProgress   UserProgress[]
  testAttempts   TestAttempt[]
  questions      Question[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([topicId, code])
}

// Belongs to exactly one of Slo (a sub-lesson's content), Chapter (a unit's
// intro, shown before its lessons), or Topic (that topic's test, shown after
// its SLOs) - enforced by a CHECK constraint in the migration since Prisma's
// schema DSL has no way to express it directly.
model ContentBlock {
  id         String    @id @default(cuid())
  slo        Slo?      @relation(fields: [sloId], references: [id], onDelete: Cascade)
  sloId      String?
  chapter    Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId  String?
  topic      Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId    String?
  orderIndex Int
  blockType  BlockType
  // Shape depends on blockType, e.g. { "text": "..." } or { "youtubeId": "..." }
  content    Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([sloId, orderIndex])
  @@index([chapterId, orderIndex])
  @@index([topicId, orderIndex])
}

// The question bank: standalone practice questions. classId/subjectId are
// required (every question needs at least that much classification);
// chapterId/topicId/sloId are optional and get more specific as they're
// available - a question can be tagged only down to class+subject if no
// matching Chapter/Topic/Slo exists yet. Chapter (see its own comment) does
// not require a Course, so tagging a question never requires lesson content
// to exist first. Not shown inline in lesson content - for in-lesson
// comprehension questions, use a ContentBlock with blockType QUESTION instead.
model Question {
  id          String        @id @default(cuid())
  class       Class         @relation(fields: [classId], references: [id])
  classId     String
  subject     Subject       @relation(fields: [subjectId], references: [id])
  subjectId   String
  chapter     Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  chapterId   String?
  topic       Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId     String?
  slo         Slo?          @relation(fields: [sloId], references: [id], onDelete: SetNull)
  sloId       String?
  type        QuestionType
  difficulty  Difficulty    @default(MEDIUM)
  // Free text, e.g. "AKU-EB 2023 Annual" - optional, used to filter the
  // question bank down to a specific past paper.
  pastPaper   String?
  // Optional, rendered above the prompt.
  imageUrl    String?
  imageAlt    String?
  prompt      String
  // Shape depends on type, e.g. MCQ: { "choices": [...], "correctIndex": 0 },
  // NUMERIC: { "answer": 4, "tolerance": 0.01 }, SHORT_TEXT: { "acceptedAnswers": [...] }
  data        Json
  explanation String?
  status      ContentStatus @default(DRAFT)
  attemptAnswers TestAttemptAnswer[]
  attempts    QuestionAttempt[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([classId, subjectId])
}

// Tracks a user's history with one Question-bank entry - one row per
// (user, question), created the moment it's first attempted (right or
// wrong), not just once solved. `solved` flips true the first time the
// check passes fully; `pointsAwarded`/`firstTryCorrect` are set then too
// (full credit if no attempt row existed before that check, half credit
// otherwise) and are otherwise inert once solved - retrying after that
// never changes them, LeetCode-style.
//
// FILL_IN_BLANK is the exception: it grades with partial credit per blank
// (see lib/points.ts's fillBlankPoints), so `correctBlanks`/
// `firstCheckBlankCount` and `pointsAwarded` can keep growing across
// multiple checks even before `solved` becomes true - blanks correct on
// the very first check are frozen at full rate, ones fixed later top up at
// half rate. Both fields are null/unused for every other question type.
model QuestionAttempt {
  id                   String    @id @default(cuid())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  question             Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId           String
  solved               Boolean   @default(false)
  solvedAt             DateTime?
  pointsAwarded        Int       @default(0)
  firstTryCorrect      Boolean   @default(false)
  correctBlanks        Json?
  firstCheckBlankCount Int?

  @@unique([userId, questionId])
  @@index([userId])
}

// A 1:1 profile row alongside Supabase's own auth.users table - id is
// always the Supabase auth user's UUID, set explicitly by the app on first
// login (see lib/auth.ts), never auto-generated. Supabase owns credentials
// entirely; this table only holds app-specific fields.
model User {
  id               String            @id
  email            String            @unique
  name             String?
  // The student's own grade level, self-selected on the profile page - used
  // to scope class-specific views (e.g. the subject-overview dashboard,
  // where a Subject like Mathematics spans multiple classes with entirely
  // different chapters). Nullable: existing users have none until they set
  // one, and picking one is optional.
  class            Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId          String?
  isAdmin          Boolean           @default(false)
  progress         UserProgress[]
  testAttempts     TestAttempt[]
  questionAttempts QuestionAttempt[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([classId])
}

model UserProgress {
  id           String         @id @default(cuid())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  slo          Slo            @relation(fields: [sloId], references: [id], onDelete: Cascade)
  sloId        String
  status       ProgressStatus @default(NOT_STARTED)
  lastViewedAt DateTime?
  updatedAt    DateTime       @updatedAt

  @@unique([userId, sloId])
}

// A generated test. scope determines which of sloId/chapterId/courseId is set.
// questionIds is a snapshot of exactly what was served, so grading stays
// consistent even if the question bank changes later.
model TestAttempt {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  scope       TestScope
  slo         Slo?      @relation(fields: [sloId], references: [id], onDelete: Cascade)
  sloId       String?
  chapter     Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId   String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String?
  questionIds Json
  score       Float?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  answers     TestAttemptAnswer[]

  @@index([userId])
}

model TestAttemptAnswer {
  id              String      @id @default(cuid())
  attempt         TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId       String
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId      String
  userAnswer      Json
  isCorrect       Boolean
  timeSpentSeconds Int?

  @@unique([attemptId, questionId])
}
